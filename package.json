{
  "name": "ad-study-helper",
  "version": "1.0.0",
  "description": "ADHD 사용자를 위한 집중력 향상 데스크톱 앱",
  "main": "src/main/index.js",
  "author": "J-siwon",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node -e \"['whitelist','focusState','learning-catalog','learning-balance','learning-assessment','learning','store','notifier','awayManager','controlServer','phoneFocusManager','gazeManager','tracker','chromeBridge'].forEach(m=>require('./src/main/'+m+'.js'))\"",
    "codex:install": "node scripts/install-codex-hook.js",
    "codex:uninstall": "node scripts/install-codex-hook.js --uninstall",
    "codex:verify": "node scripts/verify-codex-hook.js",
    "dist": "electron-builder --win portable && node scripts/copy-learning-balance-files.js"
  },
  "build": {
    "appId": "com.jsiwon.adstudyhelper",
    "productName": "ADStudyHelper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!**/*.test.js"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/get-windows/**",
      "**/src/renderer/vendor/mediapipe/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ADStudyHelper-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "get-windows": "^9.0.0",
    "ws": "^8.16.0"
  }
}
